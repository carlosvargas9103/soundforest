#!/bin/bash
#SBATCH --job-name=check-gpu-91
#--partition=zen3_0512
#--partition=zen3_0512_a100x2
#SBATCH --partition=zen3_0512_a100x2
#SBATCH --qos=zen3_0512_a100x2
#--qos=zen3_0512_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#--cpus-per-task=128
#--cpus-per-task=32
#--exclusive
#SBATCH --mem=512G
#--time=00-09:11:90
#SBATCH --hint=nomultithread

module purge
module load gcc cuda miniconda3
eval "$(conda shell.bash hook)"
conda activate py311tf

# Force libraries to stay single-threaded
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

#srun --cpu-bind=cores pip install -U pip
#srun --cpu-bind=cores pip install -r requirements.txt

srun --cpu-bind=cores python3 check_gpu.py
