#!/bin/bash -l
#SBATCH --job-name=pyforest_01
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=8
#SBATCH --mem=32GB
#SBATCH --time=00:10:00
#SBATCH --qos=serial
#
# --ntasks=1
# --qos=serial
# --chdir=/repos/forests-sounds-vargas
# --output=/out/test.txt
# --reservation=hpc-masters
# --ntasks-per-node=2
# --gres=gpu:1

module load gcc python

source ~/repos/forests-sounds-vargas/venvs/py310f/bin/activate

cd ~/repos/forests-sounds-vargas/source && python3 script_dea_region_parallel_00.py


#!/bin/bash -l
#SBATCH --job-name=pyforest_01
#SBATCH --nodes=2                       # Request 4 nodes
#SBATCH --ntasks-per-node=4             # 4 tasks per node (16 total tasks)
#SBATCH --cpus-per-task=8               # 8 CPUs per task
#SBATCH --mem=32GB                      # Memory per node
#SBATCH --time=00:10:00                 # Total time limit
#SBATCH --qos=parallel                    # Adjust QoS if needed
# --output=/out/test.txt          # Output file
# --reservation=hpc-masters       # Reservation name
# --gres=gpu:1                    # GPU resources if needed

module load gcc python

source ~/repos/forests-sounds-vargas/venvs/py310f/bin/activate

# Run the Python script in parallel across nodes
cd ~/repos/forests-sounds-vargas/source && srun --mpi=pmi2 python3 ~/repos/forests-sounds-vargas/source/script_dea_region_parallel_00.py
