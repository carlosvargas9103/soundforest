#!/bin/bash -l
#SBATCH --job-name=gpu_pyforest_03
#SBATCH --nodes=1
#--ntasks=1
#--ntasks-per-node=1
#--cpus-per-task=1
#SBATCH --mem=128GB
#SBATCH --time=10:00:00
#SBATCH --partition=h100
#--nodes=1
#--ntasks-per-node=4
#--cpus-per-task=8
#--mem=32GB
#--time=00:10:00
#--qos=serial
#--qos=kuma
#--gres=gpu:1
#--partition=h100
#--qos=kuma
# --ntasks=1
# --qos=serial
# --chdir=/repos/forests-sounds-vargas
# --output=/out/test.txt
# --reservation=hpc-masters

module load gcc python "cuda/12.4.1"

source ~/repos/forests-sounds-vargas/venvs/tpy310f_k/bin/activate

cd ~/repos/forests-sounds-vargas/source && python3 forest.py
