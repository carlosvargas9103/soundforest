@prefix fkg: <https://forest-kg.example.org/ontology#> .
@prefix res: <https://forest-kg.example.org/resource/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# FOREST-KG ontology (TBox).
# Maps rows of out/data/extraction/*.pkl (produced by source/extraction.py)
# into a knowledge graph. Instance data (ABox) is generated by
# scripts/build_kg_triples.py into out/data/kg/triples.nt, referencing the
# res: individuals declared below. See scripts/kg_pipeline_plan.html for the
# end-to-end pipeline diagram.

<https://forest-kg.example.org/ontology> a owl:Ontology ;
    rdfs:label "FOREST-KG Ontology" .

# ================= Classes =================

fkg:Sound a owl:Class ;
    rdfs:label "Sound" ;
    rdfs:comment "One audio recording: one .pkl feature file in out/data/extraction/<Region>/. Acoustic index properties are the mean over all (second, band) rows of that file." .

fkg:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "The 13 source/extraction.py:SoundscapeRegion categories a recording is drawn from (values 1-13): the 9 SONYC-UST urban sound-event classes (Noise, Engine, MachineryImpact, NonMachineryImpact, PoweredSaw, AlertSignal, Music, HumanVoice, Dog) and the 4 FOREST land-use classes (Plantation, Pasture, NaturalRegeneration, RefForest). This is the link-prediction target." .

fkg:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "Physical recorder: a SONYC acoustic sensor (numeric sensor_id parsed from the filename prefix, e.g. '00_026884.wav') or a FOREST field site (site code parsed from the filename, e.g. 'Pasture11'). Coordinates are a fixed group centroid, not per-sensor GPS -- see scripts/build_kg_triples.py." .

fkg:SoundClass a owl:Class ;
    rdfs:label "Sound Class" ;
    rdfs:comment "Upper-level grouping of fkg:Region: Urban (the 9 SONYC-UST categories) or Environmental (the 4 FOREST categories). Two fixed individuals, res:SoundClass_Urban and res:SoundClass_Environmental -- see fkg:hasSoundClass." .

# ================= Object properties =================

fkg:hasRegion a owl:ObjectProperty ;
    rdfs:label "has region" ;
    rdfs:domain fkg:Sound ;
    rdfs:range fkg:Region ;
    rdfs:comment "Asserted for every recording. Today: functional (1 Sound -> 1 Region); planned to relax to 1 Sound -> N Region." .

fkg:recordedBy a owl:ObjectProperty ;
    rdfs:label "recorded by" ;
    rdfs:domain fkg:Sound ;
    rdfs:range fkg:Sensor .

fkg:hasSoundClass a owl:ObjectProperty ;
    rdfs:label "has sound class" ;
    rdfs:domain fkg:Region ;
    rdfs:range fkg:SoundClass ;
    rdfs:comment "Asserted once per Region individual (schema-level, not per Sound): which upper class the region belongs to, Urban or Environmental. A rule-based reasoner can derive Sound -> hasSoundClass -> SoundClass by chaining through hasRegion (LO2)." .

# ================= Datatype properties: Sensor =================

fkg:sensorId a owl:DatatypeProperty ; rdfs:domain fkg:Sensor ; rdfs:range xsd:string ; rdfs:label "sensor id" .
fkg:latitude a owl:DatatypeProperty ; rdfs:domain fkg:Sensor ; rdfs:range xsd:float ; rdfs:label "latitude" .
fkg:longitude a owl:DatatypeProperty ; rdfs:domain fkg:Sensor ; rdfs:range xsd:float ; rdfs:label "longitude" .
fkg:municipality a owl:DatatypeProperty ; rdfs:domain fkg:Sensor ; rdfs:range xsd:string ; rdfs:label "municipality" .

# ================= Datatype properties: Sound -- acoustic indices =================
# Property names mirror source/extraction.py:Metrics values.

fkg:meanEnergy       a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.MEAN ('men')" .
fkg:medianEnergy     a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.MEDIAN ('med')" .
fkg:sumEnergy        a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.SUM ('sum')" .
fkg:maxEnergy        a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.MAX ('max')" .
fkg:minEnergy        a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.MIN ('min')" .
fkg:aci              a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_COMPLEXITY" .
fkg:aca              a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_COMPLEXITY_ALTERNATIVE" .
fkg:adi              a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_DIVERSITY" .
fkg:bioacousticIndex a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.BIOACOUSTIC_INDEX_BETA ('bet')" .
fkg:temporalMedian   a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.TEMPORAL_MEDIAN ('mmm')" .
fkg:numberPeaks      a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.NUMBER_PEAKS ('npp')" .
fkg:entropyFrequency a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.ENTROPY_FREQUENCY ('hfq')" .
fkg:entropyTemporal  a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.ENTROPY_TEMPORAL ('htp')" .
fkg:entropy          a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.ENTROPY ('hhh')" .
fkg:acousticEvenness a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_EVENNESS ('aei')" .
fkg:soundscapeIndex  a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.SOUNDSCAPE_INDEX ('dsi')" .
fkg:acousticRichness a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_RICHNESS ('amr')" .

# ================= Datatype properties: Sound -- provenance =================

fkg:soundscapeId    a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:integer ; rdfs:comment "Metrics.SOUNDSCAPE_ID ('sid'), constant across all rows of one file" .
fkg:durationSeconds a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:integer ; rdfs:comment "max(sec) + 1 across the file's rows" .
fkg:nRows           a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:integer ; rdfs:comment "row count of the source DataFrame (seconds x bands)" .
fkg:sourceFile       a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:string ; rdfs:comment "original audio file name (no directory)" .
fkg:pklPath           a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:string ; rdfs:comment "path to the extraction .pkl, relative to out/data/extraction/" .

# ================= Controlled vocabulary: SoundClass individuals (2) =================

res:SoundClass_Urban         a fkg:SoundClass ; rdfs:label "Urban" .
res:SoundClass_Environmental a fkg:SoundClass ; rdfs:label "Environmental" .

# ================= Controlled vocabulary: Region individuals (13) =================

res:Region_Noise               a fkg:Region ; rdfs:label "Noise" ;              fkg:hasSoundClass res:SoundClass_Urban .
res:Region_Engine              a fkg:Region ; rdfs:label "Engine" ;             fkg:hasSoundClass res:SoundClass_Urban .
res:Region_MachineryImpact     a fkg:Region ; rdfs:label "Machinery Impact" ;   fkg:hasSoundClass res:SoundClass_Urban .
res:Region_NonMachineryImpact  a fkg:Region ; rdfs:label "Non-Machinery Impact" ; fkg:hasSoundClass res:SoundClass_Urban .
res:Region_PoweredSaw          a fkg:Region ; rdfs:label "Powered Saw" ;        fkg:hasSoundClass res:SoundClass_Urban .
res:Region_AlertSignal         a fkg:Region ; rdfs:label "Alert Signal" ;       fkg:hasSoundClass res:SoundClass_Urban .
res:Region_Music               a fkg:Region ; rdfs:label "Music" ;             fkg:hasSoundClass res:SoundClass_Urban .
res:Region_HumanVoice          a fkg:Region ; rdfs:label "Human Voice" ;        fkg:hasSoundClass res:SoundClass_Urban .
res:Region_Dog                 a fkg:Region ; rdfs:label "Dog" ;               fkg:hasSoundClass res:SoundClass_Urban .
res:Region_Plantation          a fkg:Region ; rdfs:label "Plantation" ;        fkg:hasSoundClass res:SoundClass_Environmental .
res:Region_Pasture             a fkg:Region ; rdfs:label "Pasture" ;           fkg:hasSoundClass res:SoundClass_Environmental .
res:Region_NaturalRegeneration a fkg:Region ; rdfs:label "Natural Regeneration" ; fkg:hasSoundClass res:SoundClass_Environmental .
res:Region_RefForest           a fkg:Region ; rdfs:label "Reference Forest" ;   fkg:hasSoundClass res:SoundClass_Environmental .
