#!/bin/bash -l
#SBATCH --job-name=pyforest_03
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=128GB
#SBATCH --time=11:11:11
#SBATCH --gres=gpu:1
#SBATCH --partition=gpu
#SBATCH --qos=gpu

module load gcc python "cuda/12.4.1"

source ~/repos/forests-sounds-vargas/venvs/tpy310f_i/bin/activate

cd ~/repos/forests-sounds-vargas/source && python3 forest.py
