#!/bin/bash -l
#SBATCH --job-name=pyforest-05
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=192GB
#SBATCH --time=2-22:22:22
#SBATCH --gres=gpu:1
#SBATCH --partition=gpu
#SBATCH --qos=gpu

module load gcc python cuda/12.1.1

source ~/repos/forests-sounds-vargas/venvs/tpy310f_i/bin/activate

cd ~/repos/forests-sounds-vargas/source && python3 forest.py
