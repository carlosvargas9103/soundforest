#!/bin/bash -l
#SBATCH --job-name=forest:e11
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=39
#SBATCH --mem=192GB
#SBATCH --time=01-11:11:10
#SBATCH --gres=gpu:1
#SBATCH --partition=gpu
# --qos=gpu

module load gcc python cuda/12.1.1

source ~/repos/forests-sounds-vargas/venvs/tpy310f_i/bin/activate

cd ~/repos/forests-sounds-vargas/source && python3 forest.py -sota 22
