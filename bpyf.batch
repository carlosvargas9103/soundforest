#!/bin/bash -l
#SBATCH --job-name=pyforest_01
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=8
#SBATCH --mem=64GB
#SBATCH --time=10:00:00
#SBATCH --qos=serial
#
# --ntasks=1
# --qos=serial
# --chdir=/repos/forests-sounds-vargas
# --output=/out/test.txt
# --reservation=hpc-masters
# --ntasks-per-node=2
# --gres=gpu:1

module load gcc python

source ~/repos/forests-sounds-vargas/venvs/py310f/bin/activate

cd ~/repos/forests-sounds-vargas/source && python3 script_bootstrap_parallel_00.py
