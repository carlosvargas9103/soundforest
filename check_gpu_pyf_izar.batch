#!/bin/bash -l
#SBATCH --job-name=check_gpu_pyforest_01
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=128GB
#SBATCH --time=10:01:00
#SBATCH --gres=gpu:1
#SBATCH --partition=gpu-xl
#SBATCH --qos=gpu
# --ntasks=1
# --qos=serial
# --chdir=/repos/forests-sounds-vargas
# --output=/out/test.txt
# --reservation=hpc-masters
# --ntasks-per-node=2
# --gres=gpu:1

module load gcc python "cuda/12.1.1"

source ~/repos/forests-sounds-vargas/venvs/tpy310f_i/bin/activate

cd ~/repos/forests-sounds-vargas/source && python3 check_gpu.py
