@prefix fkg: <https://forest-kg.example.org/ontology#> .
@prefix res: <https://forest-kg.example.org/resource/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# FOREST-KG ontology (TBox). ABox: scripts/build_kg_triples.py ->
# out/data/kg/triples.nt. Diagrams: kg_pipeline_plan.html, kg_schema_diagram.html.

<https://forest-kg.example.org/ontology> a owl:Ontology ;
    rdfs:label "FOREST-KG Ontology" .

# Classes

fkg:Sound a owl:Class ;
    rdfs:label "Sound" ;
    rdfs:comment "One audio recording: one .pkl feature file in out/data/extraction/<AcousticContext>/ (18,567 total). Owns its (second, band) windows via fkg:hasFrame -- a forest recording (449s) has 4490 Frames, a SONYC clip (2s) has 20." .

fkg:Frame a owl:Class ;
    rdfs:label "Frame" ;
    rdfs:comment "One (second, frequency-band) window within a Sound's feature table (626,130 total across the dataset). Carries that row's own acoustic index values (no aggregation) plus fkg:second and fkg:hasBand. Reached only via its owning Sound's fkg:hasFrame -- a Frame has no fkg:hasAcousticContext/fkg:recordedBy of its own." .

fkg:Band a owl:Class ;
    rdfs:label "Frequency Band" ;
    rdfs:comment "One of the 10 fixed 1kHz bands used by source/extraction.py:DICT_BANDAS (0-1000Hz .. 9000-10000Hz). Ten individuals, res:Band_0 .. res:Band_9." .

fkg:AcousticContext a owl:Class ;
    rdfs:label "Acoustic Context" ;
    rdfs:comment "The 13 source/extraction.py:SoundscapeRegion categories a recording is drawn from (values 1-13): the 9 SONYC-UST urban sound-event classes (Noise, Engine, MachineryImpact, NonMachineryImpact, PoweredSaw, AlertSignal, Music, HumanVoice, Dog) and the 4 FOREST land-use classes (Plantation, Pasture, NaturalRegeneration, RefForest). This is the PRIMARY link-prediction target -- fine-grained, 13-way, one per Sound (recording)." .

fkg:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "Physical recorder: a SONYC acoustic sensor (numeric sensor_id parsed from the filename prefix, e.g. '00_026884.wav') or a FOREST field site (site code parsed from the filename, e.g. 'Pasture11'). Coordinates are a fixed group centroid, not per-sensor GPS -- see scripts/build_kg_triples.py." .

fkg:SoundType a owl:Class ;
    rdfs:label "Sound Type" ;
    rdfs:comment "Upper-level grouping of fkg:AcousticContext: Urban (the 9 SONYC-UST categories) or Environmental (the 4 FOREST categories). Two fixed individuals, res:SoundType_Urban and res:SoundType_Environmental -- see fkg:hasSoundType. This is the SECONDARY link-prediction target -- coarse, 2-way, one per Sound (recording)." .

# Object properties

fkg:hasFrame a owl:ObjectProperty ;
    rdfs:label "has frame" ;
    rdfs:domain fkg:Sound ;
    rdfs:range fkg:Frame ;
    rdfs:comment "A Sound's (second, band) windows. One Sound has many Frames (20 for a 2s SONYC clip, 4490 for a 449s FOREST recording) -- this is the structure a link-prediction model has to learn an AcousticContext/SoundType from, since the raw acoustic index values sit on Frame, not on Sound." .

fkg:hasAcousticContext a owl:ObjectProperty ;
    rdfs:label "has acoustic context" ;
    rdfs:domain fkg:Sound ;
    rdfs:range fkg:AcousticContext ;
    rdfs:comment "Asserted once per Sound (recording). Today: functional (1 Sound -> 1 AcousticContext); planned to relax to 1 Sound -> N AcousticContext. Primary link-prediction target." .

fkg:recordedBy a owl:ObjectProperty ;
    rdfs:label "recorded by" ;
    rdfs:domain fkg:Sound ;
    rdfs:range fkg:Sensor .

fkg:hasBand a owl:ObjectProperty ;
    rdfs:label "has frequency band" ;
    rdfs:domain fkg:Frame ;
    rdfs:range fkg:Band ;
    rdfs:comment "Which of the 10 fixed 1kHz bands this Frame's indices were computed over." .

fkg:hasSoundType a owl:ObjectProperty ;
    rdfs:label "has sound type" ;
    rdfs:domain fkg:AcousticContext ;
    rdfs:range fkg:SoundType ;
    rdfs:comment "Asserted once per AcousticContext individual (schema-level, not per Sound): which upper class the context belongs to, Urban or Environmental." .

fkg:inferredSoundType a owl:ObjectProperty ;
    rdfs:label "inferred sound type" ;
    rdfs:domain fkg:Sound ;
    rdfs:range fkg:SoundType ;
    rdfs:comment "Never asserted by scripts/build_kg_triples.py. Materialized by scripts/kg_rules.py: Sound hasAcousticContext AcousticContext hasSoundType SoundType => Sound inferredSoundType SoundType. Kept distinct from fkg:hasSoundType (whose domain is AcousticContext, not Sound) rather than overloading one property across two domains." .

fkg:inMunicipality a owl:DatatypeProperty ;
    rdfs:label "in municipality" ;
    rdfs:domain fkg:Sound ;
    rdfs:range xsd:string ;
    rdfs:comment "Never asserted by scripts/build_kg_triples.py. Materialized by scripts/kg_rules.py: Sound recordedBy Sensor municipality M => Sound inMunicipality M." .

# Datatype properties: Sensor

fkg:sensorId a owl:DatatypeProperty ; rdfs:domain fkg:Sensor ; rdfs:range xsd:string ; rdfs:label "sensor id" .
fkg:latitude a owl:DatatypeProperty ; rdfs:domain fkg:Sensor ; rdfs:range xsd:float ; rdfs:label "latitude" .
fkg:longitude a owl:DatatypeProperty ; rdfs:domain fkg:Sensor ; rdfs:range xsd:float ; rdfs:label "longitude" .
fkg:municipality a owl:DatatypeProperty ; rdfs:domain fkg:Sensor ; rdfs:range xsd:string ; rdfs:label "municipality" .

# Datatype properties: Band

fkg:lowerBoundHz a owl:DatatypeProperty ; rdfs:domain fkg:Band ; rdfs:range xsd:integer ; rdfs:label "lower bound (Hz)" .
fkg:upperBoundHz a owl:DatatypeProperty ; rdfs:domain fkg:Band ; rdfs:range xsd:integer ; rdfs:label "upper bound (Hz)" .

# Datatype properties: Frame -- acoustic indices

fkg:meanEnergy       a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.MEAN ('men')" .
fkg:medianEnergy     a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.MEDIAN ('med')" .
fkg:sumEnergy        a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.SUM ('sum')" .
fkg:maxEnergy        a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.MAX ('max')" .
fkg:minEnergy        a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.MIN ('min')" .
fkg:aci              a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_COMPLEXITY" .
fkg:aca              a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_COMPLEXITY_ALTERNATIVE" .
fkg:adi              a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_DIVERSITY" .
fkg:bioacousticIndex a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.BIOACOUSTIC_INDEX_BETA ('bet')" .
fkg:temporalMedian   a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.TEMPORAL_MEDIAN ('mmm')" .
fkg:numberPeaks      a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.NUMBER_PEAKS ('npp')" .
fkg:entropyFrequency a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.ENTROPY_FREQUENCY ('hfq')" .
fkg:entropyTemporal  a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.ENTROPY_TEMPORAL ('htp')" .
fkg:entropy          a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.ENTROPY ('hhh')" .
fkg:acousticEvenness a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_EVENNESS ('aei')" .
fkg:soundscapeIndex  a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.SOUNDSCAPE_INDEX ('dsi')" .
fkg:acousticRichness a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:float ; rdfs:comment "Metrics.ACOUSTIC_RICHNESS ('amr')" .

# Datatype properties: Frame -- provenance

fkg:second a owl:DatatypeProperty ; rdfs:domain fkg:Frame ; rdfs:range xsd:integer ; rdfs:comment "Metrics.SECOND ('sec'): which second of the source recording this frame covers." .

# Datatype properties: Sound -- provenance

fkg:soundscapeId    a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:integer ; rdfs:comment "Metrics.SOUNDSCAPE_ID ('sid')." .
fkg:sourceFile       a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:string ; rdfs:comment "original audio file name (no directory)." .
fkg:pklPath           a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:string ; rdfs:comment "path to the extraction .pkl, relative to out/data/extraction/." .
fkg:nFrames           a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:integer ; rdfs:comment "count of this Sound's Frames (= row count of the source DataFrame)." .
fkg:durationSeconds   a owl:DatatypeProperty ; rdfs:domain fkg:Sound ; rdfs:range xsd:integer ; rdfs:comment "max(sec) + 1 across this Sound's Frames." .

# Controlled vocabulary: SoundType individuals (2)

res:SoundType_Urban         a fkg:SoundType ; rdfs:label "Urban" .
res:SoundType_Environmental a fkg:SoundType ; rdfs:label "Environmental" .

# Controlled vocabulary: AcousticContext individuals (13)

res:AcousticContext_Noise               a fkg:AcousticContext ; rdfs:label "Noise" ;              fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_Engine              a fkg:AcousticContext ; rdfs:label "Engine" ;             fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_MachineryImpact     a fkg:AcousticContext ; rdfs:label "Machinery Impact" ;   fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_NonMachineryImpact  a fkg:AcousticContext ; rdfs:label "Non-Machinery Impact" ; fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_PoweredSaw          a fkg:AcousticContext ; rdfs:label "Powered Saw" ;        fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_AlertSignal         a fkg:AcousticContext ; rdfs:label "Alert Signal" ;       fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_Music               a fkg:AcousticContext ; rdfs:label "Music" ;             fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_HumanVoice          a fkg:AcousticContext ; rdfs:label "Human Voice" ;        fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_Dog                 a fkg:AcousticContext ; rdfs:label "Dog" ;               fkg:hasSoundType res:SoundType_Urban .
res:AcousticContext_Plantation          a fkg:AcousticContext ; rdfs:label "Plantation" ;        fkg:hasSoundType res:SoundType_Environmental .
res:AcousticContext_Pasture             a fkg:AcousticContext ; rdfs:label "Pasture" ;           fkg:hasSoundType res:SoundType_Environmental .
res:AcousticContext_NaturalRegeneration a fkg:AcousticContext ; rdfs:label "Natural Regeneration" ; fkg:hasSoundType res:SoundType_Environmental .
res:AcousticContext_RefForest           a fkg:AcousticContext ; rdfs:label "Reference Forest" ;   fkg:hasSoundType res:SoundType_Environmental .

# Controlled vocabulary: Band individuals (10)

res:Band_0 a fkg:Band ; rdfs:label "0-1000 Hz" ;     fkg:lowerBoundHz 0     ; fkg:upperBoundHz 1000  .
res:Band_1 a fkg:Band ; rdfs:label "1000-2000 Hz" ;  fkg:lowerBoundHz 1000  ; fkg:upperBoundHz 2000  .
res:Band_2 a fkg:Band ; rdfs:label "2000-3000 Hz" ;  fkg:lowerBoundHz 2000  ; fkg:upperBoundHz 3000  .
res:Band_3 a fkg:Band ; rdfs:label "3000-4000 Hz" ;  fkg:lowerBoundHz 3000  ; fkg:upperBoundHz 4000  .
res:Band_4 a fkg:Band ; rdfs:label "4000-5000 Hz" ;  fkg:lowerBoundHz 4000  ; fkg:upperBoundHz 5000  .
res:Band_5 a fkg:Band ; rdfs:label "5000-6000 Hz" ;  fkg:lowerBoundHz 5000  ; fkg:upperBoundHz 6000  .
res:Band_6 a fkg:Band ; rdfs:label "6000-7000 Hz" ;  fkg:lowerBoundHz 6000  ; fkg:upperBoundHz 7000  .
res:Band_7 a fkg:Band ; rdfs:label "7000-8000 Hz" ;  fkg:lowerBoundHz 7000  ; fkg:upperBoundHz 8000  .
res:Band_8 a fkg:Band ; rdfs:label "8000-9000 Hz" ;  fkg:lowerBoundHz 8000  ; fkg:upperBoundHz 9000  .
res:Band_9 a fkg:Band ; rdfs:label "9000-10000 Hz" ; fkg:lowerBoundHz 9000  ; fkg:upperBoundHz 10000 .
