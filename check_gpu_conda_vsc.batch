#!/bin/bash -l
#SBATCH --job-name=check_gpu_pyforest_01
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=128GB
#SBATCH --time=00:01:00
# --gres=gpu:1
# --ntasks=1
# --qos=serial
# --chdir=/repos/forests-sounds-vargas
# --output=/out/test.txt
# --reservation=hpc-masters
# --ntasks-per-node=2
# --gres=gpu:1

module purge
module load gcc cuda miniconda3
eval "$(conda shell.bash hook)"
conda activate py311f

cd ~/forests-sounds-vargas && python3 check_gpu.py
