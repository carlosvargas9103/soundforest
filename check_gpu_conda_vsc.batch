#!/bin/bash -l
#SBATCH --job-name=check_gpu_pyforest_03
#SBATCH --partition=zen3_0512
#--partition=zen3_0512_a100
#SBATCH --qos=zen3_0512
#--qos=zen3_0512_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=128
#--cpus-per-task=32
#SBATCH --exclusive
#--mem=0
#--time=00-09:11:90
#SBATCH --hint=nomultithread

module purge
module load gcc cuda miniconda3
eval "$(conda shell.bash hook)"
conda activate py311f

# Force libraries to stay single-threaded
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

srun --cpu-bind=cores python3 -m pip install -r requirements.txt

cd ~/forests-sounds-vargas && python3 check_gpu.py
