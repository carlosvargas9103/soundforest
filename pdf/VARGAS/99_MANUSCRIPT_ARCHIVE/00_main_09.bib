@misc{scrum-PACKT2024,
  author = {{PACKT Publishing}},
  title = {Comprehensive Guide to Agile Scrum Foundations},
  year = {2024},
  howpublished = {Online course},
  publisher = {PACKT Publishing},
  language = {eng},
