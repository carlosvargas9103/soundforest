author = {Bradfer-Lawrence, Tom and Gardner, Nick and Bunnefeld, Lynsey and Bunnefeld, Nils and Willis, Stephen G. and Dent, Daisy H.},
title = {Guidelines for the use of acoustic indices in environmental research},
journal = {Methods in Ecology and Evolution},
