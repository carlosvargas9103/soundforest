#!/bin/bash
#SBATCH --job-name=f-e90-1
#SBATCH --partition=zen3_0512
#--partition=zen3_0512_a100
#SBATCH --qos=zen3_0512
#--qos=zen3_0512_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=128
#--cpus-per-task=32
#SBATCH --exclusive
#--mem=0
#--time=00-09:11:90
#SBATCH --hint=nomultithread

module purge
module load gcc cuda miniconda3
eval "$(conda shell.bash hook)"
conda activate py311f

# Force libraries to stay single-threaded
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

cd ~/forests-sounds-vargas/source && srun --cpu-bind=cores python3 forest.py -sota 28
