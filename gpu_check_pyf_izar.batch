#!/bin/bash -l
#SBATCH --job-name=ver_gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=39
#SBATCH --mem=192GB
#SBATCH --time=0-11:11:11
#SBATCH --gres=gpu:1
#SBATCH --partition=gpu
# --qos=gpu
# --qos=debug
# --partition=l40s
# --qos=normal
# --qos=debug
# --gos=gpu
# --ntasks=1
# --qos=serial
# --chdir=/repos/forests-sounds-vargas
# --output=/out/test.txt
# --reservation=normal
# --ntasks-per-node=2
# --gres=gpu:1

module load gcc python "cuda/12.1.1"

source ~/repos/forests-sounds-vargas/venvs/tpy310f_i/bin/activate

cd ~/repos/forests-sounds-vargas/source && python3 check_gpu.py
